# 环境变量配置
# 应用
APP_NAME=tiangong-agent
APP_ENV=dev
APP_DEBUG=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=medical
DB_PASSWORD=medical123
DB_NAME=medical_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-docs
MINIO_SECURE=false

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medical123

# 主 Agent（Supervisor 和会话摘要）
DASHSCOPE_API_KEY=xxxx
BASE_URL_CHAT=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.8-flash

# 子 Agent（问诊、挂号、药物、报告、知识、运营）和所有 TruLens 评估指标
DEEPSEEK_API_KEY=xxx
DEEPSEEK_MODEL=deepseek-flash
# 填写子 Agent 的接口地址；与主 Agent 使用同一网关时填入相同地址
DEEPSEEK_BASE_URL=

# 向量模型与未来视觉模型，不参与主/子聊天模型切换
EMBEDDING_MODEL=qwen3.7-text-embedding
# 使用硅基流动时：模型填 Qwen/Qwen3-Embedding-8B，并配置以下独立密钥和地址。
# 地址可填 https://api.siliconflow.cn/v1 或完整的 /v1/embeddings。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024
VL_MODEL=qwen3.8-omni-flash

# MinerU 4.x 文档解析（mineru-kit api-server）；留空 MINERU_API_URL 时入库直接走 LlamaIndex
MINERU_API_URL=http://127.0.0.1:8000
# 服务端以 --api-key 启动时填写
MINERU_API_KEY=
# flash / basic / standard / advanced；留空使用服务端默认档位
MINERU_TIER=standard
# 单个文档解析的总等待时长（秒）
MINERU_TIMEOUT=600

# 本地解析产物目录；相对路径基于项目根目录，MinIO 使用已有知识桶
PARSED_ARTIFACT_DIR=data/parsed

# 日志
LOG_LEVEL=DEBUG
LOG_DIR=logs

# Shared JWT signing key: use your deployment's secret manager; no source-code fallback.
# Existing login issuer and ChatBI verifier must use the same strong secret (>= 32 chars).
JWT_SECRET_KEY=

# ChatBI defaults to OFF and empty grants. Do not invent role permissions.
CHATBI_ENABLED=false
# Async/sync module:function(subject: str) -> trusted user record. See docs/chatbi.md.
CHATBI_IDENTITY_PROVIDER=
# JSON object: role -> public medical table -> explicit column names, from approved RBAC.
CHATBI_ROLE_PERMISSIONS={}
# Optional development-only Gradio identity. API endpoints still require JWT.
# Local-test queries are additionally restricted to ChatBI synthetic patient/consultation fixtures.
CHATBI_LOCAL_TEST_PRINCIPAL={}
CHATBI_MAX_ROWS=500
CHATBI_POOL_SIZE=5
CHATBI_SESSION_TTL=1800
CHATBI_MAX_SESSIONS=1000
CHATBI_MODEL_TIMEOUT=60
